# Build and test the checked-out source, never an upstream clone.
FROM --platform=$BUILDPLATFORM golang:alpine3.24 AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates tzdata
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test ./...

ARG TARGETOS=linux
ARG TARGETARCH
ARG TARGETVARIANT
ARG WATCHTOWER_VERSION=local
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" GOARM="${TARGETVARIANT#v}" \
    go build -trimpath -ldflags "-s -w -X github.com/PabloMz85/watchtower/internal/meta.Version=$WATCHTOWER_VERSION" -o /out/watchtower .

FROM scratch
LABEL "com.centurylinklabs.watchtower"="true"
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /out/watchtower /watchtower
EXPOSE 8080
HEALTHCHECK CMD ["/watchtower", "--health-check"]
ENTRYPOINT ["/watchtower"]
