{
  "name": "Watchtower Dependabot metadata automation",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/dependabot-approve.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_actions_actors",
      "parameters": {
        "allowed_actors": [
          {"id": 19808080, "type": "User"},
          {"id": 49699333, "type": "Bot"}
        ]
      }
    },
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
